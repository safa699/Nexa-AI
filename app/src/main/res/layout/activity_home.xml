<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FC"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="22dp"
        android:paddingBottom="24dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_nexa_ai"
                android:contentDescription="Nexa AI logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nexa AI"
                    android:textColor="#30204F"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your intelligent workspace"
                    android:textColor="#888197"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/nexa_input_bg"
                android:gravity="center"
                android:text="✦"
                android:textColor="#7047D7"
                android:textSize="23sp"
                android:contentDescription="Nexa AI" />
        </LinearLayout>

        <!-- WELCOME SECTION -->
        <TextView
            android:id="@+id/tvHomeEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="yourname@email.com"
            android:textColor="#888197"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />


        <!-- AI HERO CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/nexa_home_card"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR AI COMPANION"
                android:textColor="#E9DFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ideas start here."
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:text="Ask questions, explore ideas and get help with your next task."
                android:textColor="#F0EAFE"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btnAskAI"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#FFFFFF"
                android:text="Start a Conversation  →"
                android:textAllCaps="false"
                android:textColor="#6339C9"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- QUICK ACTIONS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Quick actions"
            android:textColor="#30204F"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="What would you like to do today?"
            android:textColor="#888197"
            android:textSize="13sp" />

        <!-- WRITE AND SUMMARIZE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardWrite"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:background="@drawable/nexa_input_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#EDE5FF"
                    android:gravity="center"
                    android:text="✎"
                    android:textColor="#6339C9"
                    android:textSize="27sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="AI Writer"
                    android:textColor="#30204F"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Create content"
                    android:textColor="#888197"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardSummarize"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:background="@drawable/nexa_input_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#E4F0FF"
                    android:gravity="center"
                    android:text="≡"
                    android:textColor="#4269C9"
                    android:textSize="27sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Summarize"
                    android:textColor="#30204F"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Simplify long text"
                    android:textColor="#888197"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ASK AND LEARN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardLearn"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:background="@drawable/nexa_input_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#E3F6EC"
                    android:gravity="center"
                    android:text="✧"
                    android:textColor="#25845B"
                    android:textSize="27sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Learn"
                    android:textColor="#30204F"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Understand new topics"
                    android:textColor="#888197"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAsk"
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:background="@drawable/nexa_input_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#FFF0E3"
                    android:gravity="center"
                    android:text="!"
                    android:textColor="#B76A27"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Ask Anything"
                    android:textColor="#30204F"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Explore your questions"
                    android:textColor="#888197"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- FOOTER ACTION -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#6339C9"
            android:text="Log Out"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="Made for your next big idea."
            android:textColor="#938AA3"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
