<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_nexa_ai"
            android:contentDescription="Nexa AI Logo"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#172554"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Join Nexa AI and get started"
            android:textSize="13sp"
            android:textColor="#8A8FA3"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/nexa_input_bg"
            android:hint="Full Name"
            android:textColor="#172554"
            android:textColorHint="#9297A8"
            android:textSize="14sp"
            android:inputType="textPersonName"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/nexa_input_bg"
            android:hint="Email Address"
            android:textColor="#172554"
            android:textColorHint="#9297A8"
            android:textSize="14sp"
            android:inputType="textEmailAddress"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/nexa_input_bg"
            android:hint="Create Password"
            android:textColor="#172554"
            android:textColorHint="#9297A8"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:singleLine="true" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="18dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/nexa_input_bg"
            android:hint="Confirm Password"
            android:textColor="#172554"
            android:textColorHint="#9297A8"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:buttonTint="#6650D9"
            android:text="I agree to the Terms &amp; Privacy Policy"
            android:textColor="#777D91"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSignup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Create Account"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6650D9" />

        <TextView
            android:id="@+id/btnGoogle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="8dp"
            android:text="G   Sign up with Google"
            android:textColor="#4655B5"
            android:textSize="14sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="#777D91"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login"
                android:textColor="#6650D9"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="3dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
