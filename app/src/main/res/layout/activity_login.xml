<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF"
    android:overScrollMode="never">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">
        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/ic_nexa_ai"
            android:contentDescription="Nexa AI logo"
            android:layout_marginBottom="16dp" />
        <!-- Books icon -->

        <!-- Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back!"
            android:textColor="#172554"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="30dp"
            android:text="Sign in to continue with Nexa AI"
            android:textColor="#8A8FA3"
            android:textSize="13sp"
            android:gravity="center" />


        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="@drawable/nexa_input_bg"
            android:hint="Email Address"
            android:textColor="#172554"
            android:textColorHint="#9297A8"
            android:textSize="14sp"
            android:inputType="textEmailAddress"
            android:singleLine="true" />

        <!-- Password -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="@drawable/nexa_input_bg"
            android:hint="Password"
            android:textColor="#172554"
            android:textColorHint="#9297A8"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:singleLine="true" />
        <TextView
            android:id="@+id/tvForgot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forgot Password?"
            android:textColor="#6650D9"
            android:textSize="13sp"
            android:gravity="end"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true" />
        <!-- Login button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:text="Login"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6650D9" />

        <!-- Google sign-in -->
        <TextView
            android:id="@+id/btnGoogle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:padding="8dp"
            android:text="G   Sign in with Google"
            android:textColor="#4655B5"
            android:textSize="14sp"
            android:textStyle="normal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <!-- Sign up -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? "
                android:textColor="#777D91"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSignup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Up"
                android:textColor="#6650D9"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="3dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
